# =============================================================================
# Desk booking - server configuration (copy to .env)
#
# The database (SQLite / PostgreSQL / MariaDB / MySQL), single sign-on (Microsoft,
# Google, any OpenID Connect provider), SMTP mail, API and MCP are configured by an
# administrator in the app: Administration -> Settings.
# =============================================================================
ENV=test

APP_HOST=localhost
APP_PORT=2230
APP_DEBUG=false
APP_PREFIX=desks
# Public address of the app - used for SSO redirect URIs, links in e-mails and the MCP address.
APP_URL=http://localhost:2230/desks

# HTTPS served by the app itself (no reverse proxy): paths to the PEM certificate and key.
# Behind a reverse proxy (Apache / nginx / IIS) leave empty and put https:// in APP_URL.
SSL_CERT=
SSL_KEY=

# Session signing key. Empty = generated on the first start (data/session_key).
SECRET_KEY=
# Key encrypting secrets in the database (AES-256-GCM, 64 hex characters). Keep a copy outside the server -
# without it SMTP passwords, SSO secrets, the database password and API keys cannot be read.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Empty = generated on the first start (data/encryption_key).
ENCRYPTION_KEY=

# Booking rules
MAX_DAYS_AHEAD=30
SKIP_WEEKENDS=true
# Hourly bookings (rooms, booths, desks for part of the day)
BOOKING_HOURS_FROM=07:00
BOOKING_HOURS_TO=20:00
TIME_STEP_MINUTES=30
IDLE_TIMEOUT_HOURS=8

# Default SQLite database (until an administrator chooses another one in the settings)
# DB_PATH=/opt/desk-booking/data/desks.sqlite
